PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your-db-password
DB_NAME=lumen

# S3 (leave S3_BUCKET empty to use only fallback_url demo videos)
S3_BUCKET=lumen-lectures
AWS_REGION=ap-south-1

# Only needed when the frontend runs on a different origin (local dev)
# CORS_ORIGIN=http://localhost:8080
